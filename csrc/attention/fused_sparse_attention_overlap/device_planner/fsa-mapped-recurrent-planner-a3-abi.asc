// TEST267 mapped recurrent planner ABI for torch NPU tensors and a caller-owned stream.
// Build: bisheng -O2 --npu-arch=dav-2201 -fPIC -shared fsa-mapped-recurrent-planner-a3-abi.asc -o libfsa_mapped_recurrent_planner.so
//
// req int64[N], topk int32[N,2048], stable/visible int32[N], 1 <= N <= 32.
// last int64[32], banks int32[32], physicalState int32[32,4,4096]:
// per physical row, slots, LRU, inverse bank 0, inverse bank 1. Caller seeds state.
// map int32[128]: logical map, used, reset, previous bank (each with 32 lanes).
// payload int32[N,1040]: signed plan[2048] and controls[16] in int16 view of
// first 1032 words, then int32 current linear slot and 7 zero words.
// Publish writes each active row's membership [14336:16400] and metadata[0:N+1].
// All tensors contiguous. Keep their storage alive through stream and graph use.
//
// Derived from validated fsa-mapped-recurrent-planner-a3-gate.asc
// 14ee1f2ff4bcd8d26ecb6d15142a95b4ddfb915f1b639762d340dea0d9bc326f.
#include "kernel_operator.h"

namespace AscendC {
template <typename T>
__aicore__ inline void FsaLruFastProgression(
    const LocalTensor<T>& dst, T start, T diff, int32_t count)
{
    constexpr int32_t kSeed = 32 / sizeof(T);
    const auto vectorToScalar = GetTPipePtr()->FetchEventID(HardEvent::V_S);
    SetFlag<HardEvent::V_S>(vectorToScalar);
    WaitFlag<HardEvent::V_S>(vectorToScalar);
    for (int32_t lane = 0; lane < kSeed; ++lane) {
        dst.SetValue(lane, start + static_cast<T>(lane) * diff);
    }
    const auto scalarToVector = GetTPipePtr()->FetchEventID(HardEvent::S_V);
    SetFlag<HardEvent::S_V>(scalarToVector);
    WaitFlag<HardEvent::S_V>(scalarToVector);
    for (int32_t filled = kSeed; filled < count; filled *= 2) {
        const int32_t remaining = count - filled;
        const int32_t length = remaining < filled ? remaining : filled;
        Adds(dst[filled], dst, static_cast<T>(filled) * diff, length);
        PipeBarrier<PIPE_V>();
    }
}
} // namespace AscendC

#define ArithProgression FsaLruFastProgression
#include "fsa-lru-prefix-reuse-a3.h"
#include "acl/acl.h"
#include "kernel_operator.h"
#include "fsa-lru-ranked-a3.h"
#include "fsa-lru-invert-a3.h"
#include "fsa-device-planner-post-recurrent-a3.h"

#include <cstdint>

namespace {
constexpr int kTopk = 2048;
constexpr int kCapacity = 4096;
constexpr int kMaxToken = 1048576;
constexpr int kResident = kCapacity - 1;
constexpr int kHeader = 8;
constexpr int kInputWords = kHeader + kTopk + 2 * kCapacity;
constexpr int kPlanWords = kHeader + 2 * kTopk;
constexpr int kLookupWords = 4 * kTopk + 4 * kCapacity + kCapacity / 32;
constexpr int kWinnerStart = kLookupWords - kTopk;
constexpr int kUbBytes = (kInputWords + kPlanWords + kCapacity + kLookupWords) * sizeof(int32_t);
static_assert(kLookupWords == FsaLruInvert::kWorkWords);
static_assert(kWinnerStart >= FsaLruPost::kWorkWords);
static_assert(kTopk == 2048 && kMaxToken == (1 << 20));
static_assert(kInputWords % 8 == 0 && kPlanWords % 8 == 0);
static_assert(kUbBytes <= 184 * 1024);

using namespace AscendC;

__aicore__ inline int ClampLength(int length)
{
    return length < 0 ? 0 : (length > kMaxToken ? kMaxToken : length);
}

// Sort descending by key, carrying original TopK positions. For equal keys the
// ordered planner resolves the first position explicitly; hardware tie order is irrelevant.
__aicore__ inline void SortTopk(
    const LocalTensor<int32_t>& topk, LocalTensor<float> sortA, LocalTensor<float> sortB)
{
    Cast(sortA, topk, RoundMode::CAST_ROUND, kTopk);
    ArithProgression<int32_t>(sortA[kTopk].ReinterpretCast<int32_t>(), 0, 1, kTopk);
    PipeBarrier<PIPE_V>();
    Sort32(sortB, sortA, sortA[kTopk].ReinterpretCast<uint32_t>(), kTopk / 32);
    PipeBarrier<PIPE_V>();

    LocalTensor<float> from = sortB, to = sortA;
    for (int tile = 32; tile < kTopk; tile *= 4) {
        MrgSort4Info params;
        for (int i = 0; i < 4; ++i) {
            params.elementLengths[i] = tile;
        }
        params.ifExhaustedSuspension = false;
        params.validBit = 0b1111;
        params.repeatTimes = kTopk / (4 * tile);
        MrgSortSrcList<float> inputs;
        inputs.src1 = from;
        inputs.src2 = from[2 * tile];
        inputs.src3 = from[4 * tile];
        inputs.src4 = from[6 * tile];
        MrgSort<float>(to, inputs, params);
        PipeBarrier<PIPE_V>();
        auto old = from;
        from = to;
        to = old;
    }
    // For 2048 keys: three merge passes, so from=sortA, to=sortB.
    Extract(sortB, sortB[kTopk].ReinterpretCast<uint32_t>(), from, kTopk / 32);
    PipeBarrier<PIPE_V>();
}

// Find the descending lower bound of each physical slot token in parallel.
// Work in byte offsets, so each vector step needs no separate offset multiply.
__aicore__ inline LocalTensor<int32_t> LookupRows(
    const LocalTensor<int32_t>& topk, const LocalTensor<int32_t>& slots,
    const LocalTensor<float>& work)
{
    LocalTensor<float> slotKeys = work;
    LocalTensor<float> sorted = work[2 * kTopk];
    SortTopk(topk, slotKeys, sorted);
    LocalTensor<float> offsets = work[4 * kTopk];
    LocalTensor<float> candidate = work[4 * kTopk + kCapacity];
    LocalTensor<float> gathered = work[4 * kTopk + 2 * kCapacity];
    LocalTensor<int32_t> byteOffsets = work[4 * kTopk + 3 * kCapacity].ReinterpretCast<int32_t>();
    LocalTensor<uint8_t> mask = work[4 * kTopk + 4 * kCapacity].ReinterpretCast<uint8_t>();
    Cast(slotKeys, slots, RoundMode::CAST_ROUND, kCapacity);
    Duplicate(offsets, -4.0f, kCapacity);
    PipeBarrier<PIPE_V>();
    for (int step = kTopk / 2; step > 0; step >>= 1) {
        Adds(candidate, offsets, static_cast<float>(4 * step), kCapacity);
        PipeBarrier<PIPE_V>();
        Cast(byteOffsets, candidate, RoundMode::CAST_ROUND, kCapacity);
        PipeBarrier<PIPE_V>();
        Gather(gathered, sorted, byteOffsets.ReinterpretCast<uint32_t>(), 0, kCapacity);
        PipeBarrier<PIPE_V>();
        Compare(mask, gathered, slotKeys, CMPMODE::GT, kCapacity);
        PipeBarrier<PIPE_V>();
        Select(gathered, mask, candidate, offsets, SELMODE::VSEL_TENSOR_TENSOR_MODE, kCapacity);
        PipeBarrier<PIPE_V>();
        auto old = offsets;
        offsets = gathered;
        gathered = old;
    }
    Adds(candidate, offsets, 4.0f, kCapacity);
    PipeBarrier<PIPE_V>();
    Cast(byteOffsets, candidate, RoundMode::CAST_ROUND, kCapacity);
    PipeBarrier<PIPE_V>();
    Gather(gathered, sorted, byteOffsets.ReinterpretCast<uint32_t>(), 0, kCapacity);
    PipeBarrier<PIPE_V>();
    Compare(mask, gathered, slotKeys, CMPMODE::EQ, kCapacity);
    PipeBarrier<PIPE_V>();
    Select(gathered, mask, candidate, -4.0f, SELMODE::VSEL_TENSOR_SCALAR_MODE, kCapacity);
    PipeBarrier<PIPE_V>();
    Cast(byteOffsets, gathered, RoundMode::CAST_ROUND, kCapacity);
    return byteOffsets;
}

constexpr uint32_t kPhysicalRows = 32;
constexpr int kStateWords = 4 * kCapacity;
constexpr int kMembershipRowShorts = 16400;
constexpr int kControlOffset = 16384;
constexpr int kPlanStart = kControlOffset - kTopk;
constexpr int kWireShorts = kMembershipRowShorts - kPlanStart;
constexpr int kWireWords = kWireShorts / 2;
constexpr int kPayloadWords = kWireWords + 8;
static_assert(kWireWords == 1032 && kPayloadWords == 1040);
static_assert(kMembershipRowShorts % 16 == 0 && kPlanStart % 16 == 0 && kPayloadWords % 8 == 0);

constexpr uint32_t kIdWords = 2 * kPhysicalRows;
constexpr uint32_t kWordBytes = sizeof(int32_t);
constexpr uint32_t kMapperWords = 4 * kPhysicalRows;

// Inputs: contiguous int64 req_ids[logicalRows], last_req_ids[physicalRows].
// Mapping output also snapshots the read bank for each logical row.
// This one AIV commits all selected IDs and bank tags after resolving every row.
__aicore__ inline void MapStableRows(
    GM_ADDR reqIds, GM_ADDR lastIds, GM_ADDR bankTags, GM_ADDR output,
    uint32_t logicalRows, uint32_t physicalRows)
{
    if (logicalRows == 0 || logicalRows > physicalRows || physicalRows > kPhysicalRows) {
        return;
    }
    TPipe pipe;
    TBuf<TPosition::VECCALC> scratch;
    pipe.InitBuffer(scratch, (2 * kIdWords + kPhysicalRows + kMapperWords) * kWordBytes);
    auto reqWords = scratch.Get<int32_t>();
    auto lastWords = reqWords[kIdWords];
    auto req = reqWords.ReinterpretCast<int64_t>();
    auto last = lastWords.ReinterpretCast<int64_t>();
    auto banks = lastWords[kIdWords];
    auto mapped = banks[kPhysicalRows];
    auto used = mapped[kPhysicalRows];
    auto reset = used[kPhysicalRows];
    auto oldBank = reset[kPhysicalRows];
    GlobalTensor<int32_t> reqGm, lastGm, bankGm, destination;
    reqGm.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t*>(reqIds), 2 * logicalRows);
    lastGm.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t*>(lastIds), 2 * physicalRows);
    bankGm.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t*>(bankTags), physicalRows);
    destination.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t*>(output), kMapperWords);
    const DataCopyPadExtParams<int32_t> noPad{false, 0, 0, 0};
    const DataCopyExtParams reqCopy{1, 2 * logicalRows * kWordBytes, 0, 0, 0};
    const DataCopyExtParams lastCopy{1, 2 * physicalRows * kWordBytes, 0, 0, 0};
    const DataCopyExtParams physicalCopy{1, physicalRows * kWordBytes, 0, 0, 0};
    DataCopyPad(reqWords, reqGm, reqCopy, noPad);
    DataCopyPad(lastWords, lastGm, lastCopy, noPad);
    DataCopyPad(banks, bankGm, physicalCopy, noPad);
    SetFlag<HardEvent::MTE2_S>(0);
    WaitFlag<HardEvent::MTE2_S>(0);

    // The original two passes reserve all matches before a new request can evict a row.
    // A uint32 mask covers the TEST267 32-row table.
    uint32_t usedMask = 0;
    for (uint32_t row = 0; row < logicalRows; ++row) {
        const int64_t id = req.GetValue(row);
        int32_t selected = -1;
        for (uint32_t slot = 0; slot < physicalRows; ++slot) {
            const uint32_t bit = 1u << slot;
            if ((usedMask & bit) == 0 && last.GetValue(slot) == id) {
                selected = static_cast<int32_t>(slot);
                usedMask |= bit;
                break;
            }
        }
        mapped.SetValue(row, selected);
    }

    for (uint32_t row = 0; row < logicalRows; ++row) {
        int32_t selected = mapped.GetValue(row);
        if (selected < 0) {
            int32_t firstUnused = -1;
            for (uint32_t slot = 0; slot < physicalRows; ++slot) {
                if ((usedMask & (1u << slot)) != 0) {
                    continue;
                }
                if (firstUnused < 0) {
                    firstUnused = static_cast<int32_t>(slot);
                }
                if (last.GetValue(slot) == -1) {
                    selected = static_cast<int32_t>(slot);
                    break;
                }
            }
            if (selected < 0) {
                selected = firstUnused;
            }
            if (selected < 0) {
                return;
            }
            mapped.SetValue(row, selected);
            usedMask |= 1u << selected;
        }
        reset.SetValue(row, last.GetValue(selected) != req.GetValue(row) ? 1 : 0);
    }
    for (uint32_t row = 0; row < logicalRows; ++row) {
        const int32_t slot = mapped.GetValue(row);
        const int32_t bank = banks.GetValue(slot);
        oldBank.SetValue(row, bank);
        banks.SetValue(slot, 1 - bank);
        last.SetValue(slot, req.GetValue(row));
    }
    for (uint32_t slot = 0; slot < physicalRows; ++slot) {
        used.SetValue(slot, static_cast<int32_t>((usedMask >> slot) & 1u));
    }

    SetFlag<HardEvent::S_MTE3>(0);
    WaitFlag<HardEvent::S_MTE3>(0);
    const DataCopyExtParams logicalCopy{1, logicalRows * kWordBytes, 0, 0, 0};
    DataCopyPad(destination, mapped, logicalCopy);
    DataCopyPad(destination[kPhysicalRows], used, physicalCopy);
    DataCopyPad(destination[2 * kPhysicalRows], reset, logicalCopy);
    DataCopyPad(destination[3 * kPhysicalRows], oldBank, logicalCopy);
    DataCopyPad(lastGm, lastWords, lastCopy);
    DataCopyPad(bankGm, banks, physicalCopy);
}

__aicore__ inline void PlanMappedRows(
    GM_ADDR topkInput, GM_ADDR stableInput, GM_ADDR visibleInput, GM_ADDR state,
    GM_ADDR map, GM_ADDR output, uint32_t rows)
{
    const uint32_t row = GetBlockIdx();
    TPipe pipe;
    TBuf<TPosition::VECCALC> inputBuf, workBuf, planBuf, hitsBuf;
    pipe.InitBuffer(inputBuf, kInputWords * sizeof(int32_t));
    pipe.InitBuffer(workBuf, kLookupWords * sizeof(int32_t));
    pipe.InitBuffer(planBuf, kPlanWords * sizeof(int32_t));
    pipe.InitBuffer(hitsBuf, kCapacity * sizeof(int32_t));
    auto input = inputBuf.Get<int32_t>();
    auto work = workBuf.Get<float>();
    auto topk = input[kHeader];
    auto slots = input[kHeader + kTopk];
    auto lru = input[kHeader + kTopk + kCapacity];
    auto result = planBuf.Get<int32_t>();
    auto hitPositions = hitsBuf.Get<int32_t>();
    GlobalTensor<int32_t> topkGM, stableGM, visibleGM, outputGM, stateGM, mapGM;
    topkGM.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t*>(topkInput));
    stableGM.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t*>(stableInput), rows);
    visibleGM.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t*>(visibleInput), rows);
    outputGM.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t*>(output));
    stateGM.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t*>(state));
    mapGM.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t*>(map));
    DataCopy(topk, topkGM[row * kTopk], kTopk);
    DataCopy(result, mapGM, kMapperWords);
    const DataCopyExtParams lengthCopy{1, rows * kWordBytes, 0, 0, 0};
    const DataCopyPadExtParams<int32_t> noPad{false, 0, 0, 0};
    DataCopyPad(result[kMapperWords], stableGM, lengthCopy, noPad);
    DataCopyPad(result[kMapperWords + kPhysicalRows], visibleGM, lengthCopy, noPad);
    SetFlag<HardEvent::MTE2_S>(0);
    WaitFlag<HardEvent::MTE2_S>(0);
    const int physical = result.GetValue(row);
    const bool reset = result.GetValue(2 * kPhysicalRows + row) != 0;
    const int oldBank = result.GetValue(3 * kPhysicalRows + row);
    const int stateOffset = physical * kStateWords;
    auto oldInverse = stateGM[stateOffset + (2 + oldBank) * kCapacity];
    auto nextInverse = stateGM[stateOffset + (3 - oldBank) * kCapacity];
    DataCopy(slots, stateGM[stateOffset], 2 * kCapacity);
    SetFlag<HardEvent::MTE2_S>(0);
    WaitFlag<HardEvent::MTE2_S>(0);
    const int stable = ClampLength(result.GetValue(kMapperWords + row));
    const int visible = ClampLength(result.GetValue(kMapperWords + kPhysicalRows + row));
    const int reservedToken = slots.GetValue(kResident);
    const int reservedLru = lru.GetValue(kResident);
    lru.SetValue(kResident, kResident);
    SetFlag<HardEvent::S_V>(0);
    WaitFlag<HardEvent::S_V>(0);
    if (reset) {
        Duplicate(slots, int32_t{-1}, kCapacity);
        ArithProgression<int32_t>(lru, 0, 1, kCapacity);
        PipeBarrier<PIPE_V>();
    }
    LookupRows(topk, slots, work);
    PipeBarrier<PIPE_V>();
    FsaLruRanked::RankSlotHits(lru, hitPositions, work, stable, visible);

    // Inversion uses the complete lookup workspace. The plan output is unused
    // until post; once inversion is complete, move its winners into the tail
    // outside the live post workspace and reuse the output buffer for the plan.
    auto plan = result[kHeader];
    auto current = result[kHeader + kTopk];
    auto winner = work[kWinnerStart].ReinterpretCast<int32_t>();
    FsaLruInvert::InvertLruHits(hitPositions, lru, plan, work.ReinterpretCast<int32_t>());
    DataCopy(winner, plan, kTopk);
    PipeBarrier<PIPE_V>();
    const auto post = FsaLruPost::PlanAfterLookup(
        lru, slots, topk, hitPositions, winner, oldInverse, plan, current,
        work.ReinterpretCast<int32_t>(), nextInverse,
        stable, visible, reset, static_cast<event_t>(0));

    SetFlag<HardEvent::V_S>(0);
    WaitFlag<HardEvent::V_S>(0);
    slots.SetValue(kResident, reservedToken);
    lru.SetValue(kResident, reservedLru);
    // Low halfword gather keeps the signed int16 wire encoding bit-exact.
    auto packedWords = work.ReinterpretCast<int32_t>();
    auto packed = packedWords.ReinterpretCast<int16_t>();
    auto byteOffsets = packedWords[kPayloadWords];
    ArithProgression<int32_t>(byteOffsets, 0, 4, kTopk);
    PipeBarrier<PIPE_V>();
    Gather(packed, plan.ReinterpretCast<int16_t>(), byteOffsets.ReinterpretCast<uint32_t>(), 0, kTopk);
    SetFlag<HardEvent::V_S>(0);
    WaitFlag<HardEvent::V_S>(0);
    auto control = packed[kTopk];
    control.SetValue(0, int16_t{-1});
    control.SetValue(1, int16_t{0x5A45});
    control.SetValue(2, static_cast<int16_t>(kTopk));
    control.SetValue(3, static_cast<int16_t>(kPlanStart));
    control.SetValue(4, static_cast<int16_t>(physical));
    control.SetValue(5, int16_t{0x5A44});
    control.SetValue(6, static_cast<int16_t>(kCapacity));
    control.SetValue(7, int16_t{0x5A56});
    for (int i = 8; i < 16; ++i) {
        control.SetValue(i, int16_t{-1});
    }
    packedWords.SetValue(kWireWords, physical * kCapacity + post.currentLocalSlot);
    for (int i = kWireWords + 1; i < kPayloadWords; ++i) {
        packedWords.SetValue(i, int32_t{0});
    }
    SetFlag<HardEvent::S_MTE3>(0);
    WaitFlag<HardEvent::S_MTE3>(0);
    DataCopy(outputGM[row * kPayloadWords], packedWords, kPayloadWords);
    DataCopy(stateGM[stateOffset], slots, 2 * kCapacity);
}
__aicore__ inline void PublishRows(GM_ADDR payload, GM_ADDR membership, GM_ADDR metadata, uint32_t rows)
{
    const uint32_t row = GetBlockIdx();
    constexpr uint32_t kSlotLaneWords = 8;
    constexpr uint32_t kSlotScratch = kPhysicalRows * kSlotLaneWords;
    constexpr uint32_t kMetaScratch = 40;
    TPipe pipe;
    TBuf<TPosition::VECCALC> scratch;
    pipe.InitBuffer(scratch, (kWireWords + kSlotScratch + kMetaScratch) * kWordBytes);
    auto wire = scratch.Get<int32_t>();
    GlobalTensor<int32_t> payloadGM, memberGM;
    payloadGM.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t*>(payload));
    memberGM.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t*>(membership));
    DataCopy(wire, payloadGM[row * kPayloadWords], kWireWords);
    SetFlag<HardEvent::MTE2_MTE3>(0);
    WaitFlag<HardEvent::MTE2_MTE3>(0);
    DataCopy(memberGM[row * (kMembershipRowShorts / 2) + kPlanStart / 2], wire, kWireWords);

    if (row == 0) {
        // Only one block writes the contiguous metadata to keep neighboring slots independent.
        auto strided = wire[kWireWords];
        auto compact = strided[kSlotScratch];
        const DataCopyExtParams gatherSlots{static_cast<uint16_t>(rows), kWordBytes,
                                            (kPayloadWords - 1) * kWordBytes, 0, 0};
        const DataCopyPadExtParams<int32_t> noPad{false, 0, 0, 0};
        DataCopyPad(strided, payloadGM[kWireWords], gatherSlots, noPad);
        SetFlag<HardEvent::MTE2_S>(0);
        WaitFlag<HardEvent::MTE2_S>(0);
        compact.SetValue(0, int32_t{0});
        for (uint32_t logical = 0; logical < rows; ++logical) {
            compact.SetValue(logical + 1, strided.GetValue(logical * kSlotLaneWords));
        }
        SetFlag<HardEvent::S_MTE3>(0);
        WaitFlag<HardEvent::S_MTE3>(0);
        GlobalTensor<int32_t> metadataGM;
        metadataGM.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t*>(metadata));
        const DataCopyExtParams metaCopy{1, (rows + 1) * kWordBytes, 0, 0, 0};
        DataCopyPad(metadataGM, compact, metaCopy);
    }
}
} // namespace
#undef ArithProgression

extern "C" __global__ __vector__ void fsa_lru_abi_map(
    GM_ADDR req, GM_ADDR last, GM_ADDR banks, GM_ADDR map, uint32_t rows)
{
    MapStableRows(req, last, banks, map, rows, kPhysicalRows);
}

extern "C" __global__ __vector__ void fsa_lru_abi_plan(
    GM_ADDR topk, GM_ADDR stable, GM_ADDR visible, GM_ADDR state, GM_ADDR map, GM_ADDR payload, uint32_t rows)
{
    PlanMappedRows(topk, stable, visible, state, map, payload, rows);
}

extern "C" __global__ __vector__ void fsa_lru_abi_publish(
    GM_ADDR payload, GM_ADDR membership, GM_ADDR metadata, uint32_t rows)
{
    PublishRows(payload, membership, metadata, rows);
}

extern "C" __attribute__((visibility("default"))) int fsa_lru_plan_async(
    void* req, void* topk, void* stable, void* visible, void* last, void* banks,
    void* state, void* mapping, void* payload, uint32_t rows, aclrtStream stream)
{
    if (rows == 0 || rows > kPhysicalRows || !req || !topk || !stable || !visible ||
        !last || !banks || !state || !mapping || !payload) {
        return ACL_ERROR_INVALID_PARAM;
    }
    fsa_lru_abi_map<<<1, 0, stream>>>(static_cast<uint8_t*>(req), static_cast<uint8_t*>(last),
        static_cast<uint8_t*>(banks), static_cast<uint8_t*>(mapping), rows);
    fsa_lru_abi_plan<<<rows, 0, stream>>>(static_cast<uint8_t*>(topk), static_cast<uint8_t*>(stable),
        static_cast<uint8_t*>(visible), static_cast<uint8_t*>(state), static_cast<uint8_t*>(mapping),
        static_cast<uint8_t*>(payload), rows);
    return ACL_SUCCESS;
}

extern "C" __attribute__((visibility("default"))) int fsa_lru_publish_async(
    void* payload, void* membership, void* metadata, uint32_t rows, aclrtStream stream)
{
    if (rows == 0 || rows > kPhysicalRows || !payload || !membership || !metadata) {
        return ACL_ERROR_INVALID_PARAM;
    }
    fsa_lru_abi_publish<<<rows, 0, stream>>>(static_cast<uint8_t*>(payload),
        static_cast<uint8_t*>(membership), static_cast<uint8_t*>(metadata), rows);
    return ACL_SUCCESS;
}
